# The easy way: run `python3 setup_wizard.py` — it asks for everything below,
# checks your tokens and writes conf.env for you.
#
# By hand: copy this file to conf.env (and run: chmod 600 conf.env) — it holds
# your bot token(s), which are passwords.

# Which chat platforms to run: telegram, discord, or telegram,discord
BOT_PLATFORMS=telegram

# --- Telegram ---
# Paste the token @BotFather gave you after the "=". (Or leave it empty and put
# the token on its own in a file named token.txt; a token set here wins.)
TELEGRAM_BOT_TOKEN=

# Optional. Leave unset and anyone who finds your bot on Telegram can use it
# (they get their own reminders, not yours). Set it to a comma-separated list
# of chat ids to serve only those chats. See "Who can use your bot" in the
# README for how to find yours.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# --- Discord ---
# The bot token from https://discord.com/developers/applications (Bot → Reset Token):
# DISCORD_BOT_TOKEN=your_token_here

# Optional allow-lists (comma-separated ids). Empty = no limit. Every list that
# is set must match; the server list doesn't apply to DMs.
# DISCORD_ALLOWED_GUILD_IDS=
# DISCORD_ALLOWED_USER_IDS=
# DISCORD_ALLOWED_CHANNEL_IDS=
